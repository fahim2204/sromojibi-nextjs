// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum WorkerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CoverageScope {
  SPECIFIC_AREA
  ALL_UPAZILA
  ALL_DISTRICT
  ALL_DIVISION
  NATIONWIDE
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum UserRole {
  USER
  WORKER
  ADMIN
}

model User {
  id             Int       @id @default(autoincrement())
  password       String?
  last_login     DateTime?
  is_superuser   Boolean   @default(false)
  username       String    @unique
  first_name     String?
  last_name      String?
  email          String    @unique
  is_staff       Boolean   @default(false)
  is_active      Boolean   @default(true)
  date_joined    DateTime  @default(now())

  // Profile Fields
  full_name      String?
  phone          String?   @unique
  image          String?
  cover_image    String?
  bio            String?
  city           String?
  role           UserRole  @default(USER)

  // Account Status
  status         UserStatus @default(ACTIVE)
  email_verified Boolean    @default(false)

  // System Fields
  is_deleted     Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relations
  oauth_accounts UserOAuthAccount[]
  sessions       UserSession[]
  activity_logs  ActivityLog[]
  worker_profile WorkerProfile?
  otps           EmailVerificationOtp[]
  reviews        WorkerReview[]
  contact_logs   WorkerContactLog[]

  @@map("user")
}

model UserSession {
  id            Int       @id @default(autoincrement())
  fk_user_id    Int
  session_token String    @unique
  ip_address    String?
  user_agent    String?
  expires_at    DateTime
  created_at    DateTime  @default(now())

  user          User          @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)
  activity_logs ActivityLog[]

  @@index([fk_user_id])
  @@index([expires_at])
  @@map("user_session")
}

model UserOAuthAccount {
  id                 Int           @id @default(autoincrement())
  fk_user_id         Int
  provider           OAuthProvider
  provider_user_id   String
  email              String?
  access_token       String?       @db.Text
  refresh_token      String?       @db.Text
  expires_at         DateTime?
  created_at         DateTime      @default(now())

  user User @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([fk_user_id])
  @@index([email])
  @@map("user_oauth_account")
}

model EmailVerificationOtp {
  id          Int       @id @default(autoincrement())
  fk_user_id  Int
  otp_hash    String
  expires_at  DateTime
  consumed_at DateTime?
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())

  user User @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)

  @@index([fk_user_id])
  @@index([expires_at])
  @@map("email_verification_otp")
}

model ActivityLog {
  id            Int          @id @default(autoincrement())
  fk_user_id    Int
  fk_session_id Int?
  type          String
  action        String
  details       Json?
  ip            String?
  created_at    DateTime     @default(now())

  user    User         @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)
  session UserSession? @relation(fields: [fk_session_id], references: [id])

  @@index([fk_user_id, created_at])
  @@index([fk_session_id])
  @@index([type])
  @@index([created_at])
  @@map("activity_log")
}

model Category {
  id          Int             @id @default(autoincrement())
  name        String
  name_bn     String?
  slug        String          @unique
  icon        String?
  description String?
  is_active   Boolean         @default(true)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  workerCategories WorkerCategory[]

  @@map("category")
}

model WorkerProfile {
  id              Int            @id @default(autoincrement())
  fk_user_id      Int?           @unique
  full_name       String
  email           String?
  phone           String
  slug            String         @unique

  fk_division_id  String?
  fk_district_id  String?
  fk_upazila_id   String?
  fk_union_id     String?
  fk_city_area_id String?
  coverage_scope  CoverageScope  @default(SPECIFIC_AREA)

  experience      Int            @default(1)
  details         String?        @db.Text
  status          WorkerStatus   @default(PENDING)
  is_verified     Boolean        @default(false)
  rating          Decimal?       @default(0.00) @db.Decimal(3, 2)
  review_count    Int            @default(0)
  avatar_url      String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  user             User?            @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)
  workerCategories WorkerCategory[]
  divisionRef      Division?        @relation(fields: [fk_division_id], references: [id], onDelete: SetNull)
  districtRef      District?        @relation(fields: [fk_district_id], references: [id], onDelete: SetNull)
  upazilaRef       Upazila?         @relation(fields: [fk_upazila_id], references: [id], onDelete: SetNull)
  unionRef         Union?           @relation(fields: [fk_union_id], references: [id], onDelete: SetNull)
  cityAreaRef      CityArea?        @relation(fields: [fk_city_area_id], references: [id], onDelete: SetNull)
  reviews          WorkerReview[]
  contact_logs     WorkerContactLog[]

  @@index([fk_user_id])
  @@index([fk_division_id])
  @@index([fk_district_id])
  @@index([fk_upazila_id])
  @@index([fk_union_id])
  @@index([fk_city_area_id])
  @@index([coverage_scope])
  @@index([status])
  @@map("worker_profile")
}

model WorkerCategory {
  id             Int           @id @default(autoincrement())
  fk_worker_id   Int
  fk_category_id Int
  worker         WorkerProfile @relation(fields: [fk_worker_id], references: [id], onDelete: Cascade)
  category       Category      @relation(fields: [fk_category_id], references: [id], onDelete: Cascade)

  @@unique([fk_worker_id, fk_category_id])
  @@index([fk_worker_id])
  @@index([fk_category_id])
  @@map("worker_category")
}

model WorkerReview {
  id             Int           @id @default(autoincrement())
  fk_worker_id   Int
  fk_user_id     Int?
  reviewer_name  String?
  reviewer_phone String?
  rating         Int
  comment        String?       @db.Text
  created_at     DateTime      @default(now())

  worker         WorkerProfile @relation(fields: [fk_worker_id], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [fk_user_id], references: [id], onDelete: SetNull)

  @@index([fk_worker_id])
  @@index([fk_user_id])
  @@map("worker_review")
}

model WorkerContactLog {
  id           Int           @id @default(autoincrement())
  fk_worker_id Int
  fk_user_id   Int?
  channel      String        @default("PHONE")
  ip_address   String?
  user_agent   String?       @db.Text
  created_at   DateTime      @default(now())

  worker       WorkerProfile @relation(fields: [fk_worker_id], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [fk_user_id], references: [id], onDelete: SetNull)

  @@index([fk_worker_id])
  @@index([fk_user_id])
  @@index([created_at])
  @@map("worker_contact_log")
}


model Division {
  id         String          @id
  bbs_code   Int?
  title      String
  title_bn   String?
  title_en   String?
  row_status Int             @default(1)
  districts  District[]
  city_areas CityArea[]
  workers    WorkerProfile[]

  @@map("division")
}

model District {
  id              String          @id
  bbs_code        Int?
  loc_division_id String
  title           String
  title_bn        String?
  title_en        String?
  url             String?
  row_status      Int             @default(1)
  division        Division        @relation(fields: [loc_division_id], references: [id], onDelete: Cascade)
  upazilas        Upazila[]
  city_areas      CityArea[]
  workers         WorkerProfile[]

  @@index([loc_division_id])
  @@map("district")
}

model Upazila {
  id              String          @id
  bbs_code        String?
  loc_district_id String
  loc_division_id String
  title_bn        String?
  title_en        String?
  url             String?
  row_status      Int             @default(1)
  district        District        @relation(fields: [loc_district_id], references: [id], onDelete: Cascade)
  unions          Union[]
  city_areas      CityArea[]
  workers         WorkerProfile[]

  @@index([loc_district_id])
  @@index([loc_division_id])
  @@map("upazila")
}

model Union {
  id              String          @id
  bbs_code        String?
  loc_district_id String
  loc_division_id String
  loc_upazila_id  String
  title_bn        String?
  title_en        String?
  row_status      Int             @default(1)
  upazila         Upazila         @relation(fields: [loc_upazila_id], references: [id], onDelete: Cascade)
  workers         WorkerProfile[]

  @@index([loc_upazila_id])
  @@index([loc_district_id])
  @@index([loc_division_id])
  @@map("union")
}

model CityArea {
  id              String          @id @default(cuid())
  bbs_code        String?
  loc_division_id String
  loc_district_id String
  loc_upazila_id  String?
  title_bn        String
  title_en        String
  parent_thana    String?
  postal_code     String?
  row_status      Int             @default(1)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  division        Division        @relation(fields: [loc_division_id], references: [id], onDelete: Cascade)
  district        District        @relation(fields: [loc_district_id], references: [id], onDelete: Cascade)
  upazila         Upazila?        @relation(fields: [loc_upazila_id], references: [id], onDelete: SetNull)
  workers         WorkerProfile[]

  @@index([loc_division_id])
  @@index([loc_district_id])
  @@index([loc_upazila_id])
  @@index([parent_thana])
  @@index([row_status])
  @@map("city_area")
}

model NewsletterSubscriber {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  source     String   @default("homepage")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("newsletter_subscriber")
}

// ==========================================
// FIELD COLLECTOR ENGINE & ADMIN (fcadmin_* & fc_*)
// ==========================================

enum FcAdminRole {
  COLLECTOR
  LEAD
  ADMIN
}

enum FcRecordStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  MERGED
  REJECTED
}

model FcAdminUser {
  id            Int             @id @default(autoincrement())
  username      String          @unique
  password_hash String
  full_name     String
  phone         String?
  role          FcAdminRole     @default(COLLECTOR)
  is_active     Boolean         @default(true)
  last_login    DateTime?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  sessions      FcAdminSession[]
  logs          FcAdminLog[]
  sessions_run  FcCollectionSession[]

  @@map("fcadmin_user")
}

model FcAdminSession {
  id          Int         @id @default(autoincrement())
  fk_user_id  Int
  token       String      @unique
  device_info String?
  expires_at  DateTime
  created_at  DateTime    @default(now())

  user        FcAdminUser @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)

  @@index([fk_user_id])
  @@index([expires_at])
  @@map("fcadmin_session")
}

model FcAdminLog {
  id         Int          @id @default(autoincrement())
  fk_user_id Int
  action     String
  details    Json?
  ip_address String?
  created_at DateTime     @default(now())

  user       FcAdminUser  @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)

  @@index([fk_user_id, created_at])
  @@map("fcadmin_log")
}

model FcCollectionSession {
  id                 String              @id
  fk_collector_id    Int?
  collector_username String
  location_name      String
  area               String?
  division_id        String?
  district_id        String?
  upazila_id         String?
  latitude           Decimal?            @db.Decimal(10, 7)
  longitude          Decimal?            @db.Decimal(10, 7)
  accuracy           Decimal?            @db.Decimal(6, 2)
  started_at         DateTime
  ended_at           DateTime?
  total_collected    Int                 @default(0)
  notes              String?             @db.Text
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  collector          FcAdminUser?        @relation(fields: [fk_collector_id], references: [id], onDelete: SetNull)
  collected_workers  FcCollectedWorker[]

  @@index([collector_username])
  @@index([created_at])
  @@map("fc_collection_session")
}

model FcCollectedWorker {
  id              String              @id
  session_id      String
  full_name       String
  phone           String
  service_type    String
  category_id     Int?
  division_id     String?
  district_id     String?
  upazila_id      String?
  village         String?
  experience      String?
  details         String?             @db.Text
  status          FcRecordStatus      @default(DRAFT)
  is_duplicate    Boolean             @default(false)
  duplicate_notes String?
  photos          Json?
  raw_metadata    Json?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  session         FcCollectionSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@index([phone])
  @@index([status])
  @@index([created_at])
  @@map("fc_collected_worker")
}


