// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum WorkerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CoverageScope {
  SPECIFIC_AREA
  ALL_UPAZILA
  ALL_DISTRICT
  ALL_DIVISION
  NATIONWIDE
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum UserRole {
  USER
  WORKER
  ADMIN
}

model User {
  id             Int       @id @default(autoincrement())
  password       String?
  last_login     DateTime?
  is_superuser   Boolean   @default(false)
  username       String    @unique
  first_name     String?
  last_name      String?
  email          String    @unique
  is_staff       Boolean   @default(false)
  is_active      Boolean   @default(true)
  date_joined    DateTime  @default(now())

  // Profile Fields
  full_name      String?
  phone          String?   @unique
  image          String?
  cover_image    String?
  bio            String?
  city           String?
  role           UserRole  @default(USER)

  // Account Status
  status         UserStatus @default(ACTIVE)
  email_verified Boolean    @default(false)

  // System Fields
  is_deleted     Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relations
  oauth_accounts UserOAuthAccount[]
  sessions       UserSession[]
  activity_logs  ActivityLog[]
  worker_profile WorkerProfile?
  otps           EmailVerificationOtp[]
  reviews        WorkerReview[]
  contact_logs   WorkerContactLog[]
  raw_collections RawCollectionLog[]

  @@map("user")
}

model UserSession {
  id            Int       @id @default(autoincrement())
  fk_user_id    Int
  session_token String    @unique
  ip_address    String?
  user_agent    String?
  expires_at    DateTime
  created_at    DateTime  @default(now())

  user          User          @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)
  activity_logs ActivityLog[]

  @@index([fk_user_id])
  @@index([expires_at])
  @@map("user_session")
}

model UserOAuthAccount {
  id                 Int           @id @default(autoincrement())
  fk_user_id         Int
  provider           OAuthProvider
  provider_user_id   String
  email              String?
  access_token       String?       @db.Text
  refresh_token      String?       @db.Text
  expires_at         DateTime?
  created_at         DateTime      @default(now())

  user User @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_user_id])
  @@index([fk_user_id])
  @@index([email])
  @@map("user_oauth_account")
}

model EmailVerificationOtp {
  id          Int       @id @default(autoincrement())
  fk_user_id  Int
  otp_hash    String
  expires_at  DateTime
  consumed_at DateTime?
  attempts    Int       @default(0)
  created_at  DateTime  @default(now())

  user User @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)

  @@index([fk_user_id])
  @@index([expires_at])
  @@map("email_verification_otp")
}

model ActivityLog {
  id            Int          @id @default(autoincrement())
  fk_user_id    Int
  fk_session_id Int?
  type          String
  action        String
  details       Json?
  ip            String?
  created_at    DateTime     @default(now())

  user    User         @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)
  session UserSession? @relation(fields: [fk_session_id], references: [id])

  @@index([fk_user_id, created_at])
  @@index([fk_session_id])
  @@index([type])
  @@index([created_at])
  @@map("activity_log")
}

model Category {
  id          Int             @id @default(autoincrement())
  name        String
  name_bn     String?
  slug        String          @unique
  icon        String?
  description String?
  is_active   Boolean         @default(true)
  created_at  DateTime        @default(now())
  updated_at  DateTime        @updatedAt

  workerCategories WorkerCategory[]

  @@map("category")
}

model WorkerProfile {
  id              Int            @id @default(autoincrement())
  fk_user_id      Int?           @unique
  full_name       String
  email           String?
  phone           String
  whatsapp_number String?
  secondary_phone String?
  gender          Gender         @default(MALE)
  age             Int?
  landmark        String?
  slug            String         @unique

  fk_division_id  String?
  fk_district_id  String?
  fk_upazila_id   String?
  fk_union_id     String?
  fk_city_area_id String?
  coverage_scope  CoverageScope  @default(SPECIFIC_AREA)

  experience          Int            @default(1)
  details             String?        @db.Text
  status              WorkerStatus   @default(PENDING)
  is_active           Boolean        @default(true)
  is_published        Boolean        @default(true)
  is_verified         Boolean        @default(false)
  is_field_collected  Boolean        @default(false)
  rating              Decimal?       @default(0.00) @db.Decimal(3, 2)
  review_count        Int            @default(0)
  avatar_url          String?
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  user             User?            @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)
  workerCategories WorkerCategory[]
  divisionRef      Division?        @relation(fields: [fk_division_id], references: [id], onDelete: SetNull)
  districtRef      District?        @relation(fields: [fk_district_id], references: [id], onDelete: SetNull)
  upazilaRef       Upazila?         @relation(fields: [fk_upazila_id], references: [id], onDelete: SetNull)
  unionRef         Union?           @relation(fields: [fk_union_id], references: [id], onDelete: SetNull)
  cityAreaRef      CityArea?        @relation(fields: [fk_city_area_id], references: [id], onDelete: SetNull)
  reviews          WorkerReview[]
  contact_logs     WorkerContactLog[]
  raw_collections  RawCollectionLog[]

  @@index([fk_user_id])
  @@index([fk_division_id])
  @@index([fk_district_id])
  @@index([fk_upazila_id])
  @@index([fk_union_id])
  @@index([fk_city_area_id])
  @@index([coverage_scope])
  @@index([gender])
  @@index([status])
  @@index([is_active])
  @@index([is_published])
  @@index([is_verified])
  @@index([is_field_collected])
  @@map("worker_profile")
}

model WorkerCategory {
  id             Int           @id @default(autoincrement())
  fk_worker_id   Int
  fk_category_id Int
  is_primary     Boolean       @default(false)
  display_order  Int           @default(0)
  worker         WorkerProfile @relation(fields: [fk_worker_id], references: [id], onDelete: Cascade)
  category       Category      @relation(fields: [fk_category_id], references: [id], onDelete: Cascade)

  @@unique([fk_worker_id, fk_category_id])
  @@index([fk_worker_id])
  @@index([fk_category_id])
  @@index([fk_worker_id, is_primary])
  @@map("worker_category")
}

model WorkerReview {
  id             Int           @id @default(autoincrement())
  fk_worker_id   Int
  fk_user_id     Int?
  reviewer_name  String?
  reviewer_phone String?
  rating         Int
  comment        String?       @db.Text
  created_at     DateTime      @default(now())

  worker         WorkerProfile @relation(fields: [fk_worker_id], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [fk_user_id], references: [id], onDelete: SetNull)

  @@index([fk_worker_id])
  @@index([fk_user_id])
  @@map("worker_review")
}

model WorkerContactLog {
  id           Int           @id @default(autoincrement())
  fk_worker_id Int
  fk_user_id   Int?
  channel      String        @default("PHONE")
  ip_address   String?
  user_agent   String?       @db.Text
  created_at   DateTime      @default(now())

  worker       WorkerProfile @relation(fields: [fk_worker_id], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [fk_user_id], references: [id], onDelete: SetNull)

  @@index([fk_worker_id])
  @@index([fk_user_id])
  @@index([created_at])
  @@map("worker_contact_log")
}


model Division {
  id         String          @id
  bbs_code   Int?
  title      String
  title_bn   String?
  title_en   String?
  row_status Int             @default(1)
  districts  District[]
  city_areas CityArea[]
  workers    WorkerProfile[]

  @@map("division")
}

model District {
  id              String          @id
  bbs_code        Int?
  loc_division_id String
  title           String
  title_bn        String?
  title_en        String?
  url             String?
  row_status      Int             @default(1)
  division        Division        @relation(fields: [loc_division_id], references: [id], onDelete: Cascade)
  upazilas        Upazila[]
  city_areas      CityArea[]
  workers         WorkerProfile[]

  @@index([loc_division_id])
  @@map("district")
}

model Upazila {
  id              String          @id
  bbs_code        String?
  loc_district_id String
  loc_division_id String
  title_bn        String?
  title_en        String?
  url             String?
  row_status      Int             @default(1)
  district        District        @relation(fields: [loc_district_id], references: [id], onDelete: Cascade)
  unions          Union[]
  city_areas      CityArea[]
  workers         WorkerProfile[]

  @@index([loc_district_id])
  @@index([loc_division_id])
  @@map("upazila")
}

model Union {
  id              String          @id
  bbs_code        String?
  loc_district_id String
  loc_division_id String
  loc_upazila_id  String
  title_bn        String?
  title_en        String?
  row_status      Int             @default(1)
  upazila         Upazila         @relation(fields: [loc_upazila_id], references: [id], onDelete: Cascade)
  workers         WorkerProfile[]

  @@index([loc_upazila_id])
  @@index([loc_district_id])
  @@index([loc_division_id])
  @@map("union")
}

model CityArea {
  id              String          @id @default(cuid())
  bbs_code        String?
  loc_division_id String
  loc_district_id String
  loc_upazila_id  String?
  title_bn        String
  title_en        String
  parent_thana    String?
  postal_code     String?
  row_status      Int             @default(1)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  division        Division        @relation(fields: [loc_division_id], references: [id], onDelete: Cascade)
  district        District        @relation(fields: [loc_district_id], references: [id], onDelete: Cascade)
  upazila         Upazila?        @relation(fields: [loc_upazila_id], references: [id], onDelete: SetNull)
  workers         WorkerProfile[]

  @@index([loc_division_id])
  @@index([loc_district_id])
  @@index([loc_upazila_id])
  @@index([parent_thana])
  @@index([row_status])
  @@map("city_area")
}

model NewsletterSubscriber {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  source     String   @default("homepage")
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("newsletter_subscriber")
}

// ==========================================
// FIELD COLLECTOR AUTH & AUDIT (fcadmin_*)
// ==========================================

enum FcAdminRole {
  COLLECTOR
  LEAD
  ADMIN
}

model FcAdminUser {
  id            Int             @id @default(autoincrement())
  username      String          @unique
  password_hash String
  full_name     String
  phone         String?
  role          FcAdminRole     @default(COLLECTOR)
  is_active     Boolean         @default(true)
  last_login    DateTime?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  sessions      FcAdminSession[]
  logs          FcAdminLog[]
  raw_collections RawCollectionLog[]

  @@map("fcadmin_user")
}

model FcAdminSession {
  id          Int         @id @default(autoincrement())
  fk_user_id  Int
  token       String      @unique
  device_info String?
  expires_at  DateTime
  created_at  DateTime    @default(now())

  user        FcAdminUser @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)

  @@index([fk_user_id])
  @@index([expires_at])
  @@map("fcadmin_session")
}

model FcAdminLog {
  id         Int          @id @default(autoincrement())
  fk_user_id Int
  action     String
  details    Json?
  ip_address String?
  created_at DateTime     @default(now())

  user       FcAdminUser  @relation(fields: [fk_user_id], references: [id], onDelete: Cascade)

  @@index([fk_user_id, created_at])
  @@map("fcadmin_log")
}

// ==========================================
// RAW COLLECTION & AI EXTRACTION LOGS
// ==========================================

model RawCollectionLog {
  id                    Int       @id @default(autoincrement())
  collection_uuid       String    @unique @default(uuid())
  parent_log_id         Int?

  // Linked Worker Entity / Context
  entity_type           String    @default("WORKER")
  fk_worker_id          Int?

  // Surveyor / Provenance
  fk_collector_id       Int?
  fk_fcadmin_user_id    Int?
  collector_username    String?
  collection_source     String    @default("FIELD_COLLECTOR") // FIELD_COLLECTOR, PROVIDER_SUBMISSION, WEB_SCRAPED, ADMIN
  session_id            String?
  device_info           String?
  app_version           String?
  ip_address            String?

  // Geolocation & Timing
  latitude              Decimal?  @db.Decimal(10, 7)
  longitude             Decimal?  @db.Decimal(10, 7)
  accuracy_meters       Decimal?  @db.Decimal(6, 2)
  captured_at           DateTime?

  // Media & Raw Payload
  photos                Json?     // [{ file_id, storage_provider, mime_type, type, width, height, checksum, url }]
  raw_payload           Json?     // Original surveyor input snapshot

  // Stage 1: AI Vision & OCR Extraction
  ai_status             String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  ai_started_at         DateTime?
  ai_attempts           Int       @default(0)
  ai_model              String?
  ai_prompt_version     String?
  ocr_raw_text          String?   @db.Text
  ai_extracted_json     Json?
  ai_confidence         Decimal?  @db.Decimal(4, 3)
  ai_error              String?
  ai_processed_at       DateTime?

  // Stage 2: Normalization & Validation
  normalization_status  String    @default("PENDING") // PENDING, NORMALIZED, FAILED
  normalized_json       Json?
  normalization_error   String?
  normalized_at         DateTime?

  // Stage 3: Deduplication & Match Candidate
  matched_entity_type   String?
  matched_entity_id     Int?
  match_confidence      Decimal?  @db.Decimal(4, 3)

  // Stage 4: Editorial Review & Publishing
  review_status         String    @default("PENDING") // PENDING, APPROVED, REJECTED, NEEDS_REVISIT
  reviewed_by           String?
  reviewed_at           DateTime?
  rejection_reason      String?
  admin_notes           String?   @db.Text

  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  parent                RawCollectionLog?  @relation("ParentChildLogs", fields: [parent_log_id], references: [id], onDelete: SetNull)
  children              RawCollectionLog[] @relation("ParentChildLogs")
  worker                WorkerProfile?     @relation(fields: [fk_worker_id], references: [id], onDelete: SetNull)
  collector             User?              @relation(fields: [fk_collector_id], references: [id], onDelete: SetNull)
  fcadmin_user          FcAdminUser?       @relation(fields: [fk_fcadmin_user_id], references: [id], onDelete: SetNull)

  @@index([collection_uuid])
  @@index([entity_type, ai_status])
  @@index([normalization_status])
  @@index([review_status])
  @@index([collection_source])
  @@index([fk_collector_id])
  @@index([fk_fcadmin_user_id])
  @@index([fk_worker_id])
  @@map("raw_collection_log")
}




